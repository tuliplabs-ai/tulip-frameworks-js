{
  "name": "tulip-frameworks-js",
  "version": "0.1.0",
  "description": "Gate a TypeScript/JS agent's actions through Tulip's control gate — the same policy + audit chain as Python, via the gateway /v1/admit RPC.",
  "keywords": [
    "agents",
    "ai",
    "audit",
    "control",
    "gate",
    "human-in-the-loop",
    "langchain",
    "openclaw",
    "policy",
    "tulip"
  ],
  "homepage": "https://tulipagents.ai",
  "license": "Apache-2.0",
  "author": "Tulip Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuliplabs-ai/tulip-frameworks-js.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsdown": "0.22.1",
    "typescript": "^5.7.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2"
}
